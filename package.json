{
  "name": "invoice-list",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "generate:mock": "node scripts/generate-invoices.mjs",
    "api:seed": "node scripts/generate-api-db.mjs",
    "api": "json-server mock-api/db.json --port 3001",
    "check": "npm run format:check && npm run lint && npm run build",
    "verify": "npm run api:seed && npm run check"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "axios": "^1.18.1",
    "classnames": "^2.5.1",
    "date-fns": "^4.4.0",
    "formik": "^2.4.9",
    "i18next": "^26.3.6",
    "react": "^18.3.1",
    "react-datepicker": "^9.1.0",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.11",
    "react-modal": "^3.16.3",
    "react-redux": "^9.3.0",
    "react-select": "^5.10.2",
    "react-virtualized": "^9.22.6",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-modal": "^3.16.3",
    "@types/react-virtualized": "^9.22.3",
    "@vitejs/plugin-react": "^4.3.3",
    "cypress": "^15.19.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "json-server": "^1.0.0-beta.15",
    "prettier": "3.9.6",
    "sass": "^1.101.3",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10"
  }
}
